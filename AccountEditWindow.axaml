<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OfflineDAoCLauncher.AccountEditWindow"
        Title="Server Account"
        Width="500" SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,7" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="1,-3,0,9" />
    </Style>
    <Style Selector="ContentControl.field">
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
  </Window.Styles>

  <Grid Margin="12,12,12,10" ColumnDefinitions="Auto,*,Auto"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Server Name:" />
    <ContentControl Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="ServerNameBox" />
    </ContentControl>

    <!-- The engine: the folder holding the Godot Mono executable -->
    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Godot Mono Folder:" />
    <ContentControl Grid.Row="1" Grid.Column="1" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="GodotFolderBox" TextChanged="OnGodotFolderChanged" />
    </ContentControl>
    <Button Name="BrowseButton" Grid.Row="1" Grid.Column="2" Margin="6,0,0,7" Content="Browse..." Click="OnBrowseGodotClick" />
    <TextBlock Name="FolderStatus" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="status" />

    <!-- The game: the folder holding project.godot -->
    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Godot Client Folder:" />
    <ContentControl Grid.Row="3" Grid.Column="1" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="ClientFolderBox" TextChanged="OnClientFolderChanged" />
    </ContentControl>
    <Button Name="BrowseClientButton" Grid.Row="3" Grid.Column="2" Margin="6,0,0,7" Content="Browse..." Click="OnBrowseClientClick" />
    <TextBlock Name="ClientStatus" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Classes="status" />

    <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Server IP:" />
    <ContentControl Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="ServerIpBox" />
    </ContentControl>

    <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Account Name:" />
    <ContentControl Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="AccountNameBox" />
    </ContentControl>

    <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="Account Password:" />
    <ContentControl Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="PasswordBox" PasswordChar="*" />
    </ContentControl>

    <TextBlock Grid.Row="8" Grid.Column="0" Classes="label" Text="World Mode:" />
    <ContentControl Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Classes="field" Theme="{StaticResource SunkenFrame}">
      <TextBox Name="WorldModeBox" />
    </ContentControl>

    <TextBlock Name="ErrorText" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
               IsVisible="False" Foreground="#A00000" TextWrapping="Wrap" Margin="0,2,0,4" />

    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6"
                HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Name="OkButton" Content="OK" IsDefault="True" Click="OnOkClick" />
      <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
