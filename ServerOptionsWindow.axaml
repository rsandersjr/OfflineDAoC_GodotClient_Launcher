<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OfflineDAoCLauncher.ServerOptionsWindow"
        Title="Server Options"
        Width="600" Height="600"
        MinWidth="520" MinHeight="360"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico">

  <Window.Styles>
    <Style Selector="TextBlock.group">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#000080" />
      <Setter Property="Margin" Value="6,10,0,4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="14,0,10,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#505050" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,6,0" />
    </Style>
    <Style Selector="TextBlock.hint.bad">
      <Setter Property="Foreground" Value="#A00000" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="Black" />
    </Style>
  </Window.Styles>

  <Grid Margin="12,10,12,10" RowDefinitions="Auto,*,Auto,Auto">

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8">
      <Run Text="Settings section of " />
      <Run Name="PathRun" FontWeight="Bold" />
      <LineBreak />
      <Run Foreground="#505050" Text="Changes take effect the next time the server starts." />
    </TextBlock>

    <ContentControl Grid.Row="1" Theme="{StaticResource SunkenFrame}" Background="#E8E8E8">
      <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="Rows" Margin="0,0,0,10" />
      </ScrollViewer>
    </ContentControl>

    <TextBlock Name="ErrorText" Grid.Row="2" IsVisible="False" Foreground="#A00000"
               TextWrapping="Wrap" Margin="0,8,0,0" />

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
      <Button Name="DefaultsButton" Grid.Column="0" Content="Restore Defaults" Click="OnDefaultsClick" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Name="SaveButton" Content="Save" IsDefault="True" Click="OnSaveClick" />
        <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
